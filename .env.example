# Ordella — environment variables (copy to .env for local development)
# Docker Compose supplies the same defaults for containerized services.

COMPOSE_PROJECT_NAME=ordella

# -----------------------------------------------------------------------------
# API gateway
# -----------------------------------------------------------------------------
API_PORT=3000
API_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=ordella
POSTGRES_PASSWORD=ordella
POSTGRES_DB=ordella
DATABASE_URL=postgresql://ordella:ordella@localhost:5433/ordella

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# RabbitMQ
# -----------------------------------------------------------------------------
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=ordella
RABBITMQ_PASSWORD=ordella
RABBITMQ_VHOST=ordella
RABBITMQ_URL=amqp://ordella:ordella@localhost:5672/ordella
RABBITMQ_MANAGEMENT_URL=http://localhost:15672

# -----------------------------------------------------------------------------
# MinIO (S3-compatible — local substitute for AWS S3)
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=ordella-assets
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=ordella-assets
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# -----------------------------------------------------------------------------
# Mailhog (local SMTP — no real email delivery)
# -----------------------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=noreply@ordella.local
MAILHOG_UI_URL=http://localhost:8025

# -----------------------------------------------------------------------------
# Deployment / multi-tenant routing
# -----------------------------------------------------------------------------
NODE_ENV=development
PLATFORM_BASE_DOMAIN=ordella.local
ONBOARDING_HOST=app.ordella.local
ADMIN_HOST=admin.ordella.local
CORS_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3005
RUN_MIGRATIONS_ON_BOOT=false
WS_REQUIRE_AUTH=false
SENTRY_DSN=
RATE_LIMIT_TENANT_PER_MIN=6000
RATE_LIMIT_IP_PER_MIN=600

# -----------------------------------------------------------------------------
# Stripe (SaaS tenant billing — not order payments)
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=

# -----------------------------------------------------------------------------
# JWT / auth (set secrets before production)
# -----------------------------------------------------------------------------
JWT_SECRET=change-me-local-dev-only
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# Microservice URLs (host machine — placeholders until real images)
# -----------------------------------------------------------------------------
AUTH_SERVICE_URL=http://localhost:3010
CATALOG_SERVICE_URL=http://localhost:3011
ORDERS_SERVICE_URL=http://localhost:3012
PAYMENTS_SERVICE_URL=http://localhost:3013
DELIVERY_SERVICE_URL=http://localhost:3014
CUSTOMERS_SERVICE_URL=http://localhost:3015
NOTIFICATIONS_SERVICE_URL=http://localhost:3016
REPORTS_SERVICE_URL=http://localhost:3017
INTEGRATIONS_SERVICE_URL=http://localhost:3018
TENANTS_SERVICE_URL=http://localhost:3019
LOCATIONS_SERVICE_URL=http://localhost:3020
PROMOTIONS_SERVICE_URL=http://localhost:3021
AUDIT_SERVICE_URL=http://localhost:3022

# -----------------------------------------------------------------------------
# Frontend URLs
# -----------------------------------------------------------------------------
ADMIN_URL=http://localhost:3001
POS_URL=http://localhost:3002
CUSTOMER_APP_URL=http://localhost:3003
DRIVER_APP_URL=http://localhost:3004

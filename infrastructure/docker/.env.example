# Copy to infrastructure/docker/.env (or project root .env)

COMPOSE_PROJECT_NAME=ordella

# PostgreSQL
POSTGRES_USER=ordella
POSTGRES_PASSWORD=ordella
POSTGRES_DB=ordella

# RabbitMQ
RABBITMQ_USER=ordella
RABBITMQ_PASSWORD=ordella
RABBITMQ_VHOST=ordella

# MinIO (S3-compatible)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=ordella-assets

# Mailhog (no auth required locally)
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025

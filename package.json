{
  "name": "ordella",
  "version": "0.0.0",
  "private": true,
  "description": "Ordella monorepo — multi-tenant restaurant ordering platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "dev": "turbo run dev",
    "postinstall": "node scripts/ensure-shared-ui-css.mjs",
    "ensure:shared-ui-css": "node scripts/ensure-shared-ui-css.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@10.8.2",
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
